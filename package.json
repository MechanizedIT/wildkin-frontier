    "validate": "node tools/validate-submission.mjs",
    "validate:submission": "node tools/validate-submission.mjs",
    "verify": "node tools/build-submission.mjs && node tools/validate-submission.mjs",
    "zip": "node tools/zip-submission.mjs"
  },
  "dependencies": {
    "three": "0.160.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
