{
  "name": "wildkin-frontier",
  "version": "0.3.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Wildkin Frontier — Sunlit Wilds, single-player expedition adventure",
  "scripts": {
    "dev": "node tools/serve.mjs",
    "serve": "node tools/serve.mjs",
    "serve:submission": "node tools/serve.mjs --dir dist/submission --port 8081",
    "build": "node tools/build-submission.mjs",
    "build:submission": "node tools/build-submission.mjs",
    "validate": "node tools/validate-submission.mjs",
    "validate:submission": "node tools/validate-submission.mjs",
    "test": "node --test tests/**/*.test.js",
    "verify": "node --test tests/**/*.test.js && node tools/check-world.mjs && node tools/check-campaign.mjs && node tools/build-submission.mjs && node tools/validate-submission.mjs",
    "test:browser": "node tools/playtest-beta.mjs",
    "campaign:check": "node tools/check-campaign.mjs",
    "zip": "node tools/zip-submission.mjs",
    "world:generate": "node tools/generate-world.mjs",
    "world:check": "node tools/check-world.mjs",
    "test:systems": "node tools/test-beta-systems.mjs",
    "test:boundaries": "node tools/test-beta-boundaries.mjs",
    "test:combat": "node tools/playtest-beta-combat.mjs",
    "test:author": "node tools/playtest-beta-author.mjs",
    "test:package": "node tools/test-beta-package.mjs",
    "test:sunlit-ui": "node tools/playtest-sunlit-ui.mjs",
    "test:traversal": "node tools/playtest-sunlit-traversal.mjs",
    "test:landscape": "node tools/playtest-landscape-ui.mjs",
    "test:hazards": "node tools/playtest-sunlit-hazard.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "three": "0.160.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1"
  }
}
